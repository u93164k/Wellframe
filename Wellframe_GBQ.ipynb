        "import datetime\n",
        "from google.colab import auth\n",
        "from google.cloud import bigquery\n",
        "\n",
        "# Authenticate (Colab)\n",
        "auth.authenticate_user()\n",
        "\n",
        "bq = bigquery.Client()"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "execution_count": null,
      "outputs": [],
      "source": [
        "# -------------------------\n",
        "# Parameters (match SAS)\n",
        "# -------------------------\n",
        "schema = \"idd-ecwmeta-prod-1\"     # &schema in SAS\n",
        "tgtschema = \"idd-cmsr-prod-1\"    # &tgtschema in SAS\n",
        "\n",
        "# SAS: %let beg_dt = '2019-09-01';\n",
        "beg_dt = datetime.date(2019, 9, 1)\n",
        "\n",
        "# SAS: end_dt set to current date at runtime via date()\n",
        "end_dt = datetime.date.today()\n",
        "\n",
        "# SAS FSN list (exact)\n",
        "fsn = [\n",
        "    280,325,10,20,30,40,50,60,80,90,100,110,120,130,135,137,138,\n",
        "    140,150,160,170,180,190,340,350,360,370,380,\n",
        "    630,640,650,660,665,710,720,725,726,730,735,736,737,738,739,745,760,765,770,\n",
        "    65,345,667,890,891,892,365,366,367\n",
        "]\n",
        "\n",
        "print(\"beg_dt:\", beg_dt)\n",
        "print(\"end_dt:\", end_dt)\n",
        "print(\"fsn count:\", len(fsn))"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Execute BigQuery load (DELETE + INSERT)\n",
        "\n",
        "This cell runs a single BigQuery multi-statement script:\n",
        "1) `BEGIN TRANSACTION`\n",
        "2) `DELETE` all rows from the target table\n",
        "3) `INSERT INTO` the target table using a `WITH` clause that mirrors the SAS temp tables\n",
        "4) `COMMIT TRANSACTION`\n",
        "\n",
        "If the target table does not exist yet, create it ahead of time with the correct schema.\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "execution_count": null,
      "outputs": [],
      "source": [
        "sql = f\"\"\"\n",
        "BEGIN TRANSACTION;\n",
        "\n",
        "DELETE FROM `{tgtschema}.CMSR.wellframe_update_final` WHERE TRUE;\n",
        "\n",
        "INSERT INTO `{tgtschema}.CMSR.wellframe_update_final` (\n",
        "  ACCESS_CODE,\n",
        "  CARE_MGR_ID,\n",
        "  MBR_GNDR_CD,\n",
        "  MBR_ID,\n",
        "  ACCESS,\n",
        "  MBR_NO,\n",
        "  MBR_KEY,\n",
        "  MSTR_PAT_ID,\n",
        "  GRP_NO,\n",
        "  FSN,\n",
        "  AGE,\n",
        "  CONTACT_TYP,\n",
        "  MSG_AUTHOR_TYP,\n",
        "  MBR_EFCT_DTM,\n",
        "  MBR_ONBRD_DT,\n",
        "  LOG_DATE,\n",
        "  CARE_MGR_NME,\n",
        "  COST_CENTER,\n",
        "  COST_CENTER_NAME,\n",
        "  STAFF_TITLE,\n",
        "  ACCESS_CHANNEL,\n",
        "  ACCESS_LOB,\n",
        "  ACCESS_PROGRAM\n",
        ")\n",
        "WITH\n",
        "/* 1) GT_ALL_MBRS */\n",
        "gt_all_mbrs AS (\n",
        "  SELECT\n",
        "      E.INSR_ID,\n",
        "      E.MBR_ID,\n",
        "      E.FRCST_SEQ_NUM AS FSN,\n",
        "      M.MBR_NUM AS MBR_NO,\n",
        "      M.MSTR_PRSN_ID AS MSTR_PAT_ID,\n",
        "      E.GRP_ID AS GRP_NO,\n",
        "      SUM(E.EMM_RTO) AS EMM,\n",
        "      SUM(IF(E.RX_BEN_IND = 'Y', E.EMM_RTO, 0)) AS EMM_RX\n",
        "  FROM `{schema}.ECW_V.ELIGIBILITY_SPAN` E\n",
        "  INNER JOIN `{schema}.ECW_V.MEMBER` M\n",
        "    ON E.INSR_ID = M.INSR_ID\n",
        "   AND E.MBR_ID = M.MBR_ID\n",
        "  WHERE E.FRCST_SEQ_NUM IN UNNEST(@fsn)\n",
        "    AND E.HLTH_PLN_POL_TYP_ID = 'M'\n",
        "    AND E.SPN_STRT_DT BETWEEN @beg_dt AND @end_dt\n",
        "    AND E.MBR_COB_ORDR_ID IS NULL\n",
        "  GROUP BY\n",
        "      E.INSR_ID,\n",
        "      E.MBR_ID,\n",
        "      E.FRCST_SEQ_NUM,\n",
        "      M.MBR_NUM,\n",
        "      M.MSTR_PRSN_ID,\n",
        "      E.GRP_ID\n",
        "),\n",
        "\n",
        "/* 2) GT_TABLE2 */\n",
        "gt_table2 AS (\n",
        "  SELECT\n",
        "    MSTR_PAT_ID,\n",
        "    LEAST(12, SUM(EMM)) AS MBR_MOS,\n",
        "    LEAST(12, SUM(EMM_RX)) AS MBR_MOS_RX\n",
        "  FROM gt_all_mbrs\n",
        "  GROUP BY MSTR_PAT_ID\n",
        "),\n",
        "\n",
        "/* 3) GT_ENGAGEMENT */\n",
        "gt_engagement AS (\n",
        "  SELECT DISTINCT\n",
        "    MB.MSTR_PRSN_ID AS MSTR_PAT_ID,\n",
        "    ENG.SNAPSHT_DT AS SNAPSHT_MO_DT,\n",
        "    ENG.ENG_STS_CD,\n",
        "    PGM.RLUP_ID AS SRC_CRE_PGM_VNDR_CD,\n",
        "    ENG.PGM_ID AS SRC_CRE_PGM_CD,\n",
        "    STS.ENG_STS_DESC,\n",
        "    ENG.DGTAL_IND_FLG\n",
        "  FROM `{schema}.ECW_V.PROGRAM_ENGAGEMENT_SNAPSHOT_COMM` ENG\n",
        "  INNER JOIN `{schema}.ECW.PROGRAM_ROLLUP_XREF` PGM\n",
        "    ON ENG.INSR_ID = PGM.INSR_ID\n",
        "   AND ENG.PGM_ID = PGM.PGM_ID\n",
        "   AND 'PGM_TYP' = PGM.RLUP_TYP_ID\n",
        "  INNER JOIN `{schema}.ECW_V.MEMBER` MB\n",
        "    ON ENG.INSR_ID = MB.INSR_ID\n",
        "   AND ENG.MBR_ID = MB.MBR_ID\n",
        "  INNER JOIN `{schema}.ECW_V.ELIGIBILITY_SPAN` ENRL\n",
        "    ON ENG.INSR_ID = ENRL.INSR_ID\n",
        "   AND ENG.MBR_ID = ENRL.MBR_ID\n",
        "  INNER JOIN `{schema}.ECW.PROGRAM_ENGAGEMENT_STATUS_REF` STS\n",
        "    ON ENG.ENG_STS_CD = STS.ENG_STS_CD\n",
        "  WHERE PGM.RLUP_ID = 'CM'\n",
        "    AND ENRL.FRCST_SEQ_NUM IN UNNEST(@fsn)\n",
        "    AND ENG.SNAPSHT_DT >= @beg_dt\n",
        "    AND ENG.SNAPSHT_DT <= @end_dt\n",
        "),\n",
        "\n",
        "/* 4) GT_ENGAGEMENT_FUNNEL_STATUS_ALL3 */\n",
        "gt_engagement_agg AS (\n",
        "  SELECT\n",
        "    MSTR_PAT_ID,\n",
        "    MAX(ENG_STS_CD) AS MAX_ENG,\n",
        "    MAX(DGTAL_IND_FLG) AS DGTL_FLG,\n",
        "    SRC_CRE_PGM_VNDR_CD,\n",
        "    SRC_CRE_PGM_CD\n",
        "  FROM gt_engagement\n",
        "  WHERE SRC_CRE_PGM_VNDR_CD = 'CM'\n",
        "  GROUP BY MSTR_PAT_ID, SRC_CRE_PGM_VNDR_CD, SRC_CRE_PGM_CD\n",
        "),\n",
        "gt_engagement_desc AS (\n",
        "  SELECT DISTINCT ENG_STS_CD, ENG_STS_DESC, DGTAL_IND_FLG\n",
        "  FROM gt_engagement\n",
        "),\n",
        "gt_engagement_funnel_status_all3 AS (\n",
        "  SELECT\n",
        "    A.MSTR_PAT_ID,\n",
        "    A.MBR_MOS,\n",
        "    A.MBR_MOS_RX,\n",
        "    B.DGTL_FLG,\n",
        "    B.MAX_ENG,\n",
        "    B.SRC_CRE_PGM_VNDR_CD,\n",
        "    B.SRC_CRE_PGM_CD,\n",
        "    C.ENG_STS_DESC\n",
        "  FROM gt_table2 A\n",
        "  INNER JOIN gt_engagement_agg B\n",
        "    ON A.MSTR_PAT_ID = B.MSTR_PAT_ID\n",
        "  LEFT JOIN gt_engagement_desc C\n",
        "    ON B.MAX_ENG = C.ENG_STS_CD\n",
        "   AND B.DGTL_FLG = C.DGTAL_IND_FLG\n",
        "),\n",
        "\n",
        "/* 5) GT_ALL */\n",
        "gt_all AS (\n",
        "  SELECT\n",
        "    A.MSTR_PAT_ID,\n",
        "    A.MBR_MOS,\n",
        "    A.MBR_MOS_RX,\n",
        "    B.DGTL_FLG,\n",
        "    CAST(B.MAX_ENG AS INT64) AS MAX_ENG_NUM,\n",
        "    B.SRC_CRE_PGM_VNDR_CD,\n",
        "    B.SRC_CRE_PGM_CD,\n",
        "    B.ENG_STS_DESC,\n",
        "    IF(A.MBR_MOS >= 12, 1, 0) AS CE\n",
        "  FROM gt_table2 A\n",
        "  LEFT JOIN gt_engagement_funnel_status_all3 B\n",
        "    ON A.MSTR_PAT_ID = B.MSTR_PAT_ID\n",
        "),\n",
        "\n",
        "/* 6) GT_ALL_MBRS3 */\n",
        "gt_all_mbrs3_a AS (\n",
        "  SELECT DISTINCT\n",
        "    E.INSR_ID,\n",
        "    E.MBR_ID,\n",
        "    E.FRCST_SEQ_NUM AS FSN,\n",
        "    M.MBR_NUM,\n",
        "    M.MSTR_PRSN_ID,\n",
        "    E.GRP_ID,\n",
        "    E.SPN_STRT_DT\n",
        "  FROM `{schema}.ECW_V.ELIGIBILITY_SPAN` E\n",
        "  INNER JOIN `{schema}.ECW_V.MEMBER` M\n",
        "    ON E.INSR_ID = M.INSR_ID\n",
        "   AND E.MBR_ID = M.MBR_ID\n",
        "  WHERE E.FRCST_SEQ_NUM IN UNNEST(@fsn)\n",
        "    AND E.HLTH_PLN_POL_TYP_ID = 'M'\n",
        "    AND E.SPN_STRT_DT BETWEEN @beg_dt AND @end_dt\n",
        "    AND E.MBR_COB_ORDR_ID IS NULL\n",
        "),\n",
        "gt_all_mbrs3_b AS (\n",
        "  SELECT\n",
        "    E2.INSR_ID,\n",
        "    E2.MBR_ID,\n",
        "    MAX(E2.SPN_STRT_DT) AS MAX_MO\n",
        "  FROM `{schema}.ECW_V.ELIGIBILITY_SPAN` E2\n",
        "  GROUP BY E2.INSR_ID, E2.MBR_ID\n",
        "),\n",
        "gt_all_mbrs3 AS (\n",
        "  SELECT DISTINCT\n",
        "    A.MBR_NUM AS MBR_NO,\n",
        "    A.MBR_ID,\n",
        "    A.INSR_ID,\n",
        "    A.MSTR_PRSN_ID AS MSTR_PAT_ID,\n",
        "    A.GRP_ID AS GRP_NO,\n",
        "    A.FSN\n",
        "  FROM gt_all_mbrs3_a A\n",
        "  INNER JOIN gt_all_mbrs3_b B\n",
        "    ON A.INSR_ID = B.INSR_ID\n",
        "   AND A.MBR_ID = B.MBR_ID\n",
        "   AND A.SPN_STRT_DT = B.MAX_MO\n",
        "),\n",
        "\n",
        "/* 7) GT_ALL2 */\n",
        "gt_all2 AS (\n",
        "  SELECT\n",
        "    A.MSTR_PAT_ID,\n",
        "    A.MBR_MOS,\n",
        "    A.MBR_MOS_RX,\n",
        "    A.DGTL_FLG,\n",
        "    A.MAX_ENG_NUM,\n",
        "    A.SRC_CRE_PGM_VNDR_CD,\n",
        "    A.SRC_CRE_PGM_CD,\n",
        "    A.ENG_STS_DESC,\n",
        "    A.CE,\n",
        "    B.MBR_NO,\n",
        "    B.MBR_ID,\n",
        "    B.INSR_ID,\n",
        "    B.GRP_NO,\n",
        "    B.FSN\n",
        "  FROM gt_all A\n",
        "  LEFT JOIN gt_all_mbrs3 B\n",
        "    ON A.MSTR_PAT_ID = B.MSTR_PAT_ID\n",
        "),\n",
        "\n",
        "/* 8) GT_ACCESS */\n",
        "gt_access AS (\n",
        "  SELECT DISTINCT\n",
        "    A.MBR_ACCESS_CODE AS ACCESS_CODE,\n",
        "    A.MBR_ADDED_BY AS CARE_MGR_ID,\n",
        "    '' AS ENRL_RSN,\n",
        "    CAST(NULL AS DATE) AS LST_CNTCT_DTM,\n",
        "    A.MBR_DOB,\n",
        "    A.MBR_INVITED_DT AS MBR_EFCT_DTM,\n",
        "    COALESCE(A.MBR_ONBOARDED_DT, A.MBR_INVITED_DT) AS MBR_ONBRD_DT,\n",
        "    A.MBR_GENDER AS MBR_GNDR_CD,\n",
        "    A.MBR_ID,\n",
        "    C.MBR_STATUS,\n",
        "    CASE\n",
        "      WHEN REGEXP_CONTAINS(\n",
        "        SUBSTR(TRIM(A.MBR_ACCESS_CODE), LENGTH(TRIM(A.MBR_ACCESS_CODE)) - 3, 1),\n",
        "        r'^[0-9]$'\n",
        "      ) THEN SUBSTR(TRIM(A.MBR_ACCESS_CODE), 1, LENGTH(TRIM(A.MBR_ACCESS_CODE)) - 4)\n",
        "      ELSE SUBSTR(TRIM(A.MBR_ACCESS_CODE), 1, LENGTH(TRIM(A.MBR_ACCESS_CODE)) - 3)\n",
        "    END AS ACCESS\n",
        "  FROM `{schema}.RTPD.WELLFRAME_FDE_MEMBERS` A\n",
        "  LEFT JOIN `{schema}.RTPD.WELLFRAME_FDE_MEMBER_STATUS_CHANGES` C\n",
        "    ON A.MBR_ID = C.MBR_NO\n",
        "   AND A.GRP_NO = C.GRP_NO\n",
        "   AND A.PROGRAM_USER_ID = C.PROGRAM_USER_ID\n",
        "  WHERE A.MBR_INVITED_DT BETWEEN @beg_dt AND @end_dt\n",
        "),\n",
        "\n",
        "/* 9) GT_ACCESS_ALL2 */\n",
        "elig_e AS (\n",
        "  SELECT\n",
        "    es.INSR_ID,\n",
        "    es.MBR_ID,\n",
        "    m.MSTR_PRSN_ID AS MSTR_PAT_ID,\n",
        "    es.FRCST_SEQ_NUM AS FSN,\n",
        "    m.MBR_NUM AS MBR_NO,\n",
        "    es.GRP_ID AS GRP_NO,\n",
        "    MAX(es.SPN_STRT_DT) AS MAX_SPN_STRT_DT\n",
        "  FROM `{schema}.ECW_V.ELIGIBILITY_SPAN` es\n",
        "  INNER JOIN `{schema}.ECW_V.MEMBER` m\n",
        "    ON es.INSR_ID = m.INSR_ID\n",
        "   AND es.MBR_ID = m.MBR_ID\n",
        "  WHERE es.FRCST_SEQ_NUM IN UNNEST(@fsn)\n",
        "    AND es.HLTH_PLN_POL_TYP_ID = 'M'\n",
        "    AND es.SPN_STRT_DT BETWEEN @beg_dt AND @end_dt\n",
        "  GROUP BY\n",
        "    es.INSR_ID,\n",
        "    es.MBR_ID,\n",
        "    m.MSTR_PRSN_ID,\n",
        "    es.FRCST_SEQ_NUM,\n",
        "    m.MBR_NUM,\n",
        "    es.GRP_ID\n",
        "),\n",
        "gt_access_all2 AS (\n",
        "  SELECT DISTINCT\n",
        "    a.ACCESS_CODE,\n",
        "    a.ACCESS,\n",
        "    ac.target_descr AS access_channel,\n",
        "    al.target_descr AS access_lob,\n",
        "    ap.target_descr AS access_program,\n",
        "    a.mbr_dob,\n",
        "    a.mbr_gndr_cd,\n",
        "    a.mbr_id,\n",
        "    COALESCE(b.mbr_no, e.mbr_no) AS mbr_no,\n",
        "    COALESCE(b.mstr_pat_id, e.mstr_pat_id) AS mstr_pat_id,\n",
        "    COALESCE(b.grp_no, e.grp_no) AS grp_no,\n",
        "    COALESCE(b.fsn, e.fsn) AS fsn,\n",
        "    a.mbr_efct_dtm,\n",
        "    a.mbr_onbrd_dt,\n",
        "    CASE\n",
        "      WHEN EXTRACT(MONTH FROM CURRENT_DATE()) > EXTRACT(MONTH FROM a.mbr_dob)\n",
        "       AND EXTRACT(DAY FROM CURRENT_DATE()) >= EXTRACT(DAY FROM a.mbr_dob)\n",
        "      THEN EXTRACT(YEAR FROM CURRENT_DATE()) - EXTRACT(YEAR FROM a.mbr_dob)\n",
        "      ELSE EXTRACT(YEAR FROM CURRENT_DATE()) - EXTRACT(YEAR FROM a.mbr_dob) - 1\n",
        "    END AS age\n",
        "  FROM gt_access a\n",
        "  INNER JOIN elig_e e\n",
        "    ON a.mbr_id = e.mbr_no\n",
        "  LEFT JOIN `{tgtschema}.cmsr.wellframe_access_decode_v` ac\n",
        "    ON a.access = ac.access_code_abbr\n",
        "   AND ac.target_type = 'ACCESS_CHANNEL'\n",
        "   AND ac.start_date <= CURRENT_DATE()\n",
        "   AND ac.end_date = DATE '9999-12-31'\n",
        "  LEFT JOIN `{tgtschema}.cmsr.wellframe_access_decode_v` al\n",
        "    ON a.access = al.access_code_abbr\n",
        "   AND al.target_type = 'ACCESS_LOB'\n",
        "   AND al.start_date <= CURRENT_DATE()\n",
        "   AND al.end_date = DATE '9999-12-31'\n",
        "  LEFT JOIN `{tgtschema}.cmsr.wellframe_access_decode_v` ap\n",
        "    ON a.access = ap.access_code_abbr\n",
        "   AND ap.target_type = 'ACCESS_PROGRAM'\n",
        "   AND ap.start_date <= CURRENT_DATE()\n",
        "   AND ap.end_date = DATE '9999-12-31'\n",
        "  LEFT JOIN gt_all2 b\n",
        "    ON a.mbr_id = b.mbr_no\n",
        "),\n",
        "\n",
        "/* 10) GT_COMBINE */\n",
        "gt_combine AS (\n",
        "  SELECT DISTINCT\n",
        "    a.MBR_NO AS mbr_id,\n",
        "    a.STAFF_ID AS care_mgr_id,\n",
        "    'message' AS contact_typ,\n",
        "    'CareManager' AS msg_author_typ,\n",
        "    a.SENT_DATE AS log_date\n",
        "  FROM `{schema}.rtpd.WELLFRAME_FDE_STAFF_MESSAGES` a\n",
        "  WHERE a.mbr_no IS NOT NULL\n",
        "\n",
        "  UNION ALL\n",
        "\n",
        "  SELECT DISTINCT\n",
        "    a.MBR_NO AS mbr_id,\n",
        "    a.PROGRAM_USER_ID AS care_mgr_id,\n",
        "    'message' AS contact_typ,\n",
        "    'ProgramUser' AS msg_author_typ,\n",
        "    a.SENT_DATE AS log_date\n",
        "  FROM `{schema}.rtpd.WELLFRAME_FDE_MEMBER_MESSAGES` a\n",
        "  WHERE a.mbr_no IS NOT NULL\n",
        "\n",
        "  UNION ALL\n",
        "\n",
        "  SELECT DISTINCT\n",
        "    MBR_NO AS mbr_id,\n",
        "    STAFF_ID AS care_mgr_id,\n",
        "    'call' AS contact_typ,\n",
        "    'call' AS msg_author_typ,\n",
        "    call_date AS log_date\n",
        "  FROM `{schema}.rtpd.WELLFRAME_FDE_PHONE_CALLS`\n",
        "  WHERE mbr_no IS NOT NULL\n",
        "\n",
        "  UNION ALL\n",
        "\n",
        "  SELECT DISTINCT\n",
        "    a.MBR_NO AS mbr_id,\n",
        "    b.MBR_ADDED_BY AS care_mgr_id,\n",
        "    CASE\n",
        "      WHEN a.EVENT_TYPE = 'basic_reminder' THEN 'BasicReminder'\n",
        "      WHEN a.EVENT_TYPE = 'med_reminder' THEN 'MedicationReminder'\n",
        "      WHEN a.EVENT_TYPE = 'content' THEN 'Content'\n",
        "      WHEN a.EVENT_TYPE = 'encouragement' THEN 'Encouragement'\n",
        "      WHEN a.EVENT_TYPE = 'physical_act' THEN 'Physical Act'\n",
        "      WHEN a.EVENT_TYPE = 'survey' THEN 'Survey'\n",
        "    END AS contact_typ,\n",
        "    CASE\n",
        "      WHEN a.EVENT_TYPE IN ('basic_reminder','med_reminder') THEN 'reminder'\n",
        "      ELSE a.event_type\n",
        "    END AS msg_author_typ,\n",
        "    a.COMPLETED_DATE AS log_date\n",
        "  FROM `{schema}.RTPD.WELLFRAME_FDE_TASK_EVENTS` a\n",
        "  INNER JOIN `{schema}.RTPD.WELLFRAME_FDE_MEMBERS` b\n",
        "    ON a.PROGRAM_USER_ID = b.PROGRAM_USER_ID\n",
        "   AND a.MBR_NO = b.MBR_ID\n",
        "   AND a.GRP_NO = b.GRP_NO\n",
        "  WHERE a.MBR_NO IS NOT NULL\n",
        "    AND a.COMPLETED_DATE IS NOT NULL\n",
        "),\n",
        "\n",
        "/* Care manager dimension (SAS inline view c) */\n",
        "care_mgr_dim AS (\n",
        "  SELECT DISTINCT\n",
        "    cs.staff_id AS care_mgr_id,\n",
        "    cs.staff_title,\n",
        "    CONCAT(TRIM(cs.last_name), ',', TRIM(cs.first_name)) AS care_mgr_nme,\n",
        "    emp.DEPARTMENT_ID AS cost_center,\n",
        "    COALESCE(emp.DEPARTMENT_NAME, cs.STAFF_EMAIL) AS cost_center_name\n",
        "  FROM `{schema}.rtpd.wellframe_fde_staff` cs\n",
        "  LEFT JOIN `{schema}.CBDW.CBDW_EMPLOYEE_INFO` emp\n",
        "    ON LOWER(TRIM(cs.STAFF_EMAIL)) = LOWER(TRIM(emp.EMP_EML))\n",
        "   AND emp.TERM_DT IS NULL\n",
        ")\n",
        "\n",
        "SELECT DISTINCT\n",
        "  a.access_code AS ACCESS_CODE,\n",
        "  b.care_mgr_id AS CARE_MGR_ID,\n",
        "  a.mbr_gndr_cd AS MBR_GNDR_CD,\n",
        "  a.mbr_id AS MBR_ID,\n",
        "  a.access AS ACCESS,\n",
        "  a.mbr_no AS MBR_NO,\n",
        "  a.mbr_id AS MBR_KEY,\n",
        "  a.mstr_pat_id AS MSTR_PAT_ID,\n",
        "  a.grp_no AS GRP_NO,\n",
        "  a.fsn AS FSN,\n",
        "  a.age AS AGE,\n",
        "  b.contact_typ AS CONTACT_TYP,\n",
        "  b.msg_author_typ AS MSG_AUTHOR_TYP,\n",
        "  a.mbr_efct_dtm AS MBR_EFCT_DTM,\n",
        "  a.mbr_onbrd_dt AS MBR_ONBRD_DT,\n",
        "  b.log_date AS LOG_DATE,\n",
        "  c.care_mgr_nme AS CARE_MGR_NME,\n",
        "  c.cost_center AS COST_CENTER,\n",
        "  c.cost_center_name AS COST_CENTER_NAME,\n",
        "  c.staff_title AS STAFF_TITLE,\n",
        "  a.access_channel AS ACCESS_CHANNEL,\n",
        "  a.access_lob AS ACCESS_LOB,\n",
        "  a.access_program AS ACCESS_PROGRAM\n",
        "FROM gt_access_all2 a\n",
        "LEFT JOIN gt_combine b\n",
        "  ON a.mbr_id = b.mbr_id\n",
        "LEFT JOIN care_mgr_dim c\n",
        "  ON b.care_mgr_id = c.care_mgr_id\n",
        "WHERE a.mbr_id IS NOT NULL\n",
        "  AND b.log_date BETWEEN @beg_dt AND @end_dt\n",
        ";\n",
        "\n",
        "COMMIT TRANSACTION;\n",
        "\"\"\"\n",
        "\n",
        "job_config = bigquery.QueryJobConfig(\n",
        "    query_parameters=[\n",
        "        bigquery.ScalarQueryParameter(\"beg_dt\", \"DATE\", beg_dt),\n",
        "        bigquery.ScalarQueryParameter(\"end_dt\", \"DATE\", end_dt),\n",
        "        bigquery.ArrayQueryParameter(\"fsn\", \"INT64\", fsn),\n",
        "    ]\n",
        ")\n",
        "\n",
        "print(\"Submitting DELETE+INSERT transaction...\")\n",
        "job = bq.query(sql, job_config=job_config)\n",
        "job.result()\n",
        "print(\"Done. Refreshed:\", f\"{tgtschema}.CMSR.wellframe_update_final\")"
      ]
    },
